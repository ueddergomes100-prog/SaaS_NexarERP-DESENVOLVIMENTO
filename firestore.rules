rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    function currentTenantId() {
      return hasProfile() ? currentProfile().tenantId : null;
    }

    function currentRole() {
      return hasProfile() ? currentProfile().role : null;
    }

    function tokenIsSuperAdmin() {
      return signedIn() && (
        request.auth.token.role == 'NexarAdmin' ||
        request.auth.token.nexarAdmin == true ||
        request.auth.token.role == 'SuperAdmin' ||
        request.auth.token.superAdmin == true
      );
    }

    function isSuperAdmin() {
      return tokenIsSuperAdmin() || (hasProfile() && currentRole() in ['NexarAdmin', 'SuperAdmin']);
    }

    function isTenantAdmin() {
      return hasProfile() && currentRole() in ['Master', 'Admin'];
    }

    // Funcionario nivel Gerente (nivelAcesso, campo de VISIBILIDADE DE
    // VENDA -- ver visibilidadeVendasDomain.ts) tambem pode mexer na
    // permissao de acesso de um Funcionario comum, decisao de 2026-09-23.
    // 'administracao' e' o nome antigo do mesmo nivel, ainda gravado em
    // empresa que marcou antes da troca de nome.
    function isGerenteDeEquipe() {
      return hasProfile() &&
        currentRole() == 'Funcionario' &&
        currentProfile().nivelAcesso in ['gerente', 'administracao'];
    }

    function hasPermission(permission) {
      return hasProfile() &&
        currentProfile().permissoes is list &&
        currentProfile().permissoes.hasAny([permission]);
    }

    function hasAnyPermission(permissions) {
      return hasProfile() &&
        currentProfile().permissoes is list &&
        currentProfile().permissoes.hasAny(permissions);
    }

    function platformManagedFields() {
      return [
        'modulosBloqueados',
        'modulosContratados',
        'plano',
        'valorMensalidade',
        'limiteUsuarios',
        // Limite de acessos ao aplicativo mobile (vendedor externo). Mesmo
        // motivo do limiteUsuarios: contratado a parte, so o SuperAdmin
        // altera. Padrao quando ausente e' 0 -- ver acessoMobileDomain.ts.
        'limiteAcessoMobile',
        'limites',
        'statusSaas',
        'billingStatus',
        'trialEndsAt',
        // Id da empresa na Spedy (auditoria de 2026-09-29). O servidor usa a
        // chave MESTRA da plataforma nesse id (PUT /api/spedy/numbering, GET
        // /requisitos) -- se o Admin da empresa pudesse trocar, apontaria pra
        // empresa de OUTRO cliente e mexeria na numeracao/ambiente fiscal
        // dela. So' o servidor grava (Admin SDK, ver spedyCompanies.routes.js).
        'spedyCompanyId'
      ];
    }

    function doesNotChangePlatformManagedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(platformManagedFields());
    }

    // Metadados de responsabilidade do Modulo 20 (documentMetadata.ts). TODA
    // escrita do app passou a envia-los em 2026-07-31, mas esta regra nao foi
    // atualizada junto -- o hasOnly() abaixo passou a recusar silenciosamente
    // qualquer edicao de usuario feita por Admin de empresa (SuperAdmin nao
    // sentia, porque isSuperAdmin() curto-circuita antes). Sintoma: "Nao foi
    // possivel salvar as permissoes" e o perfil nao salvar o proprio nome.
    function documentAuditFields() {
      return ['alteradoPor', 'alteradoEm', 'ultimaAlteracao'];
    }

    function tenantUserEditableFields() {
      return [
        'nome',
        'updatedAt',
        'permissoes',
        // Nivel de visibilidade de vendas (funcionario/administracao). Fica
        // aqui, e nao junto de 'role', de proposito: nao troca o papel do
        // usuario nem libera modulo, so decide quais vendas ele enxerga.
        // Ver src/utils/visibilidadeVendasDomain.ts.
        'nivelAcesso',
        // Codigo do vendedor (2 digitos, publico) usado no popup de
        // identificacao da venda. Estava FALTANDO aqui: o campo era gravavel
        // na criacao do funcionario, mas qualquer edicao posterior batia em
        // "Missing or insufficient permissions" -- ou seja, trocar ou
        // corrigir o codigo de alguem ja cadastrado era impossivel. E' o
        // mesmo campo que o cadastro de Vendedores (sem login) escreve.
        // Ver src/utils/vendedorPinDomain.ts e vendedorCadastroDomain.ts.
        'codigoVendedor',
        'recebeComissaoServicos',
        'comissaoPercentualServicos',
        'recebeComissaoPecas',
        'comissaoPercentualPecas',
        'status',
        // Acesso ao aplicativo mobile (vendedor externo). So liga se a
        // empresa tiver limiteAcessoMobile contratado -- ver
        // acessoMobileDomain.ts. Nao e' platformManagedFields: quem liga/
        // desliga por pessoa e' o Admin/Master da propria empresa, dentro
        // do limite que so o SuperAdmin controla.
        'acessoAppMobile'
      ].concat(documentAuditFields());
    }

    function canManageTenantData() {
      return isSuperAdmin() || isTenantAdmin();
    }

    function cadastroDeBancoSemMexerNoSaldo() {
      return (
        resource == null &&
        request.resource.data.get('saldoCentavos', 0) == request.resource.data.get('saldoInicialCentavos', 0)
      ) || (
        resource != null &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['saldoCentavos', 'saldoInicialCentavos'])
      );
    }

    function canWriteTenantCollection(collectionName) {
      return canManageTenantData() ||
        (collectionName in ['clientes', 'veiculos'] && hasAnyPermission(['cadastros.clientes', 'vendas.pedidos', 'vendas.orcamentos', 'mecanica.os', 'crm.agenda', 'crm.alertas'])) ||
        (collectionName in ['produtos', 'cotacoes_compra', 'pedidos_compra', 'recebimentos_compra', 'historico_custos', 'produtos_composicao', 'entregas'] && hasPermission('cadastros.estoque')) ||
        // estoque (o cadastro do produto em si, com custo/margem/fornecedor)
        // saiu do grupo acima em 2026-08-28: cadastros.estoque virou "ver a
        // lista", so cadastros.estoque_alterar cria/edita o produto. Nota
        // Avulsa tambem grava aqui (soma quantidade + atualiza precoCusto),
        // por isso aceita estoque.nota_avulsa como alternativa. Precificacao
        // grava preco/margem em lote na mesma colecao -- sem ela na lista, a
        // tela apareceria e o save seria recusado pelo backend.
        (collectionName == 'estoque' && hasAnyPermission(['cadastros.estoque_alterar', 'estoque.nota_avulsa', 'estoque.precificacao'])) ||
        // estoque_lotes: mesma logica -- exige a permissao de alterar cadastro
        // ou a de Ajuste Manual de Estoque, nunca so "ver a lista". A Entrada de NF-e (fiscal.entrada)
        // tambem cria/soma lote e a exclusao da nota o estorna.
        (collectionName == 'estoque_lotes' && hasAnyPermission(['cadastros.estoque_alterar', 'estoque.ajusteManual', 'fiscal.entrada', 'estoque.nota_avulsa', 'operacoes.producao'])) ||
        // Fornecedores ganhou permissao propria (antes vinha no balaio de
        // cadastros.estoque). Aceita tambem fiscal.entrada porque a Entrada de
        // XML CRIA fornecedor durante a importacao (EntradaNFE.tsx) -- sem
        // isso, importar nota de fornecedor novo quebraria.
        (collectionName == 'fornecedores' && hasAnyPermission(['cadastros.fornecedores', 'fiscal.entrada'])) ||
        // Controle de rota: cadastro do motorista e as despesas da viagem.
        // Quem lanca e' a LOJA (decisao do dono, 2026-09-21) -- o motorista
        // nao escreve aqui pelo app.
        (collectionName == 'motoristas' && hasPermission('operacoes.rotas')) ||
        // Frota propria (veiculos da EMPRESA, 2026-09-25): mesma permissao da rota/motorista.
        (collectionName == 'frota' && hasPermission('operacoes.rotas')) ||
        (collectionName == 'rotas' && hasPermission('operacoes.rotas')) ||
        // Romaneio de entrega (2026-10-01): a rota em si e a trava de cada pedido (romaneio_pedidos/{pedidoId}),
        // que impede o mesmo pedido de sair em duas rotas. Exclusao nunca: a trava e' liberada, nao apagada.
        (collectionName in ['romaneios', 'romaneio_pedidos'] && hasPermission('operacoes.romaneios')) ||
        // Promocoes (2026-10-01): a tela Promocoes e a promocao individual do cadastro do produto.
        (collectionName == 'promocoes' && hasAnyPermission(['vendas.promocoes', 'cadastros.estoque_alterar'])) ||
        (collectionName == 'materias_primas' && hasPermission('cadastros.materia_prima')) ||
        // Insumos (material de consumo, 2026-09-25): mesma permissao da materia-prima; a Entrada de NF-e
        // tambem os cria/atualiza, entao aceita fiscal.entrada.
        (collectionName == 'insumos' && hasAnyPermission(['cadastros.materia_prima', 'fiscal.entrada'])) ||
        (collectionName == 'ordens_producao' && hasPermission('operacoes.producao')) ||
        (collectionName == 'expedicoes' && hasPermission('operacoes.expedicao')) ||
        (collectionName == 'categorias' && hasPermission('cadastros.categorias')) ||
        // Marcas ganha as MESMAS 3 permissoes que ja escrevem produto/materia-
        // prima (alem do cadastro proprio) -- sem isso, importar Estoque ou
        // Materia-Prima quebraria na hora de criar a marca que falta, ja que
        // essas telas nao pedem cadastros.marcas separado.
        (collectionName == 'marcas' && hasAnyPermission(['cadastros.marcas', 'cadastros.estoque_alterar', 'cadastros.materia_prima'])) ||
        (collectionName == 'servicos' && hasPermission('cadastros.servicos')) ||
        (collectionName == 'unidades_medida' && hasPermission('cadastros.unidades_medida')) ||
        (collectionName == 'bandeiras_cartao' && hasPermission('cadastros.bandeiras_cartao')) ||
        // Banco: cadastro (agencia, conta, convenio do boleto) so' com a
        // permissao do cadastro. Venda, OS, baixa etc. mexem SO' no saldo --
        // ver canMoveBankBalance().
        // Desde 2026-10-05 (fatia 2) o cadastro NAO mexe no saldo: lancamento
        // manual e transferencia sao gravados pelo servidor. O banco nasce com
        // saldo = saldo inicial e, depois, saldo e saldo inicial nao mudam por aqui.
        (collectionName == 'bancos' && hasPermission('cadastros.bancos') && cadastroDeBancoSemMexerNoSaldo()) ||
        (collectionName == 'lancamentos_bancarios' && hasPermission('cadastros.bancos')) ||
        (collectionName == 'ordens_de_servico' && hasAnyPermission(['mecanica.os', 'mecanica.os_alterar'])) ||
        // vendas.pedidos_pendentes_editar cobre tanto editar/finalizar quanto
        // recusar um pedido "Em Analise" vindo de integracao externa (agente
        // de WhatsApp) -- as 4 permissoes granulares de cliente/qtd/adicionar/
        // excluir item so existem no lado da UI, nao aqui (decisao deliberada,
        // sem precedente de regra por campo neste projeto).
        // As permissoes de pre_venda seguem o mesmo criterio: aqui vale so o
        // nivel "pode escrever em pedidos_venda". A separacao entre gravar,
        // editar, finalizar e cancelar pre-venda vive na UI, junto com a
        // config trabalhaComPreVenda -- mesma decisao ja tomada acima pras
        // granulares do pedido do agente.
        (collectionName == 'pedidos_venda' && hasAnyPermission(['vendas.pedidos', 'vendas.alterar', 'vendas.pedidos_pendentes_editar', 'vendas.pre_venda_criar', 'vendas.pre_venda_editar', 'vendas.pre_venda_finalizar', 'vendas.pre_venda_cancelar'])) ||
        (collectionName == 'orcamentos' && hasAnyPermission(['vendas.orcamentos', 'vendas.orcamentos_alterar'])) ||
        (collectionName == 'devolucoes_venda' && hasPermission('vendas.devolucao')) ||
        (collectionName == 'lembretes' && hasPermission('crm.alertas')) ||
        (collectionName == 'agendamentos' && hasPermission('crm.agenda')) ||
        (collectionName == 'notas_fiscais' && hasAnyPermission(['fiscal.emitir', 'fiscal.excluir'])) ||
        (collectionName == 'notas_fiscais_entrada' && hasPermission('fiscal.entrada')) ||
        (collectionName == 'creditos_cliente' && hasAnyPermission(['vendas.pedidos', 'financeiro.receber'])) ||
        (collectionName == 'transacoes' && hasAnyPermission(['financeiro.caixa', 'financeiro.banco', 'financeiro.cheques', 'financeiro.boletos', 'financeiro.receber', 'financeiro.pagar', 'financeiro.estornar', 'vendas.pedidos', 'vendas.orcamentos', 'mecanica.os', 'estoque.nota_avulsa'])) ||
        (collectionName == 'caixas_pdv' && hasAnyPermission(['vendas.pedidos', 'financeiro.caixa_registros'])) ||
        (collectionName == 'notas_avulsas' && hasPermission('estoque.nota_avulsa')) ||
        (collectionName in ['integracoes_canais', 'integracoes_produtos', 'integracoes_fila', 'pedidos_externos', 'integracoes_logs'] && hasPermission('cadastros.estoque'));
    }

    // Fechado pra so SuperAdmin (2026-09-03: "nada do sistema pode
    // excluir"). Toda tela do app trocou exclusao fisica por
    // cancelar/inativar (status/ativo); o unico delete fisico que sobra e'
    // o wipe de tenant do SuperAdmin (SuperAdmin.tsx), que roda como
    // SuperAdmin mesmo. Antes disto, Tenant Admin (dono/gestor da propria
    // empresa) tambem passava por aqui com permissao granular -- agora,
    // mesmo sem UI nenhuma chamando mais deleteDoc nessas colecoes, o
    // caminho ficava aberto pra quem soubesse chamar a API direto.
    function canDeleteTenantCollection(collectionName) {
      return isSuperAdmin();
    }

    // Funcionario INATIVADO (Usuarios / Vendedores) perde o acesso aos DADOS,
    // nao so' a tela (2026-09-29). "Inativar" e' o que substitui excluir no
    // sistema, mas so' o AuthContext barrava: o login dele no Firebase Auth
    // continua valido, e pelo console do navegador ele lia e gravava tudo o
    // que as permissoes davam. Dono/Admin nao sao inativados pela tela e
    // ficam de fora de proposito (mesma regra do AuthContext).
    function perfilAtivo() {
      return currentProfile().get('status', 'Ativo') != 'Inativo' ||
        currentProfile().get('role', '') in ['Master', 'Admin', 'NexarAdmin', 'SuperAdmin'];
    }

    function canAccessTenant(tenantId) {
      return isSuperAdmin() || (hasProfile() && perfilAtivo() && currentTenantId() == tenantId);
    }

    function canReadTenantDocument() {
      // resource == null quando o documento nao existe (ex: transaction.get
      // de um id de pagamento que nunca foi criado) -- sem essa checagem,
      // resource.data.tenantId quebra a avaliacao da regra e o Firestore
      // devolve "Missing or insufficient permissions" em vez de so dizer
      // que o documento nao existe. Permitir aqui e seguro: nao ha dado
      // nenhum pra vazar num documento inexistente.
      return isSuperAdmin() || (hasProfile() && perfilAtivo() && (resource == null || resource.data.tenantId == currentTenantId()));
    }

    function canCreateTenantDocument() {
      return isSuperAdmin() ||
        (hasProfile() && perfilAtivo() && request.resource.data.tenantId == currentTenantId());
    }

    function canUpdateTenantDocument() {
      return isSuperAdmin() ||
        (
          hasProfile() &&
          perfilAtivo() &&
          resource.data.tenantId == currentTenantId() &&
          request.resource.data.tenantId == resource.data.tenantId
        );
    }

    function canAdjustStockQuantity() {
      return hasProfile() &&
        resource.data.tenantId == currentTenantId() &&
        request.resource.data.tenantId == resource.data.tenantId &&
        // quantidadeReservada entra (2026-09-21): pre-venda RESERVA estoque
        // (a reserva e' gravada junto, na mesma transacao). Sem ela o vendedor
        // que so' tem permissao de venda recebia "Missing or insufficient
        // permissions" ao criar/cancelar pre-venda -- so' dono/gestor passava.
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['quantidade', 'quantidadeReservada', 'updatedAt']) &&
        hasAnyPermission([
          'vendas.pedidos', 'vendas.alterar', 'vendas.orcamentos', 'mecanica.os', 'mecanica.os_alterar', 'estoque.ajusteManual',
          'vendas.pre_venda_criar', 'vendas.pre_venda_editar', 'vendas.pre_venda_finalizar', 'vendas.pre_venda_cancelar'
          // 'financeiro.boletos' SAIU daqui (2026-09-29): tinha entrado por
          // engano -- o comentario dizia "boleto consome a sequencia do nosso
          // numero", que e' canConsumeTenantSequence(), e nao o estoque. Com
          // ela aqui, quem so' emitia boleto conseguia mudar quantidade de
          // produto, e continuava sem conseguir emitir boleto.
        ]);
    }

    // Movimento de SALDO do banco (2026-09-29). Venda, OS, baixa de titulo,
    // cheque, boleto, nota avulsa, entrada de NF-e e devolucao so' somam ou
    // tiram do saldo. Antes, essas permissoes gravavam o banco INTEIRO --
    // agencia, conta, o convenio do boleto (codigo do cliente, proximo nosso
    // numero) -- entao um vendedor com o DevTools aberto trocava a conta de
    // destino do boleto. O cadastro do banco ficou so' com cadastros.bancos.
    // A lista abaixo e' a antiga (sem cadastros.bancos) MAIS as telas que ja
    // mexiam no saldo sem constar dela (boleto, entrada de NF-e, devolucao,
    // alterar/cancelar venda, finalizar pre-venda, estorno) -- quem so' tinha
    // essas permissoes batia em "Missing or insufficient permissions".
    //
    // 2026-10-05 (item 8 da auditoria, fatia 1): financeiro.receber, .pagar e
    // .estornar SAIRAM da lista. Baixa e estorno de titulo agora sao gravados
    // pelo servidor (POST /api/financeiro/baixa e /estorno, Admin SDK), entao
    // quem so' da' baixa nao precisa -- e nao pode mais -- escrever saldo de
    // banco pelo navegador. As proximas fatias tiram as demais.
    //
    // 2026-10-05 (fatia 2): financeiro.banco, .cheques e .boletos tambem
    // SAIRAM. Conciliar cartao, compensar cheque (recebido e emitido) e baixa
    // de boleto pelo retorno passaram para o servidor (/api/financeiro/...).
    // Ficam so' venda, OS, devolucao, nota avulsa e entrada de NF-e (fatias 3/4).
    function canMoveBankBalance() {
      return hasProfile() &&
        resource.data.tenantId == currentTenantId() &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['saldoCentavos', 'updatedAt'].concat(documentAuditFields())) &&
        hasAnyPermission([
          'vendas.pedidos', 'vendas.alterar', 'vendas.orcamentos', 'vendas.devolucao', 'vendas.pre_venda_finalizar',
          'mecanica.os', 'mecanica.os_alterar',
          'estoque.nota_avulsa', 'fiscal.entrada'
        ]);
    }

    // Baixa por lote (2026-09-25): a venda/OS/orcamento/devolucao mexe SO' no saldo do lote, exatamente
    // como canAdjustStockQuantity faz com o estoque -- quem so' vende nao cria nem edita lote a mao.
    function canAdjustLoteQuantity() {
      return hasProfile() &&
        resource.data.tenantId == currentTenantId() &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['quantidade', 'updatedAt']) &&
        hasAnyPermission([
          'vendas.pedidos', 'vendas.alterar', 'vendas.orcamentos', 'mecanica.os', 'mecanica.os_alterar', 'estoque.ajusteManual',
          'vendas.pre_venda_criar', 'vendas.pre_venda_editar', 'vendas.pre_venda_finalizar', 'vendas.pre_venda_cancelar',
          'operacoes.producao', 'estoque.nota_avulsa', 'fiscal.entrada'
        ]);
    }

    // Ajuste de Estoque tambem cobre materia-prima (2026-09-19): o saldo dela
    // nao se edita mais no cadastro. So' a permissao de Ajuste Manual --
    // quem so' vende nao mexe em materia-prima.
    function canAdjustMateriaPrimaQuantity() {
      return hasProfile() &&
        resource.data.tenantId == currentTenantId() &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['quantidade', 'updatedAt']) &&
        hasPermission('estoque.ajusteManual');
    }

    // Modulo 12 (Conferencia de mercadoria): quem so tem operacoes.expedicao
    // NAO tem vendas.alterar, entao nao pode editar o pedido de venda em
    // geral -- mas precisa fechar/reabrir a conferencia, que grava campos
    // proprios em pedidos_venda (ver docs/PLANO_EVOLUCAO_NEXAR.md, Modulo
    // 12). Restrito exatamente aos campos da conferencia, nunca aos campos
    // de negocio da venda (itens, valores, status de pagamento etc).
    function canCloseConferenciaOnPedido() {
      return hasProfile() &&
        resource.data.tenantId == currentTenantId() &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['statusConferencia', 'conferidoPor', 'conferidoPorNome', 'conferidoEm', 'alteradoPor', 'alteradoEm']) &&
        hasPermission('operacoes.expedicao');
    }

    // ---------------------------------------------------------------------
    // SITUACAO (ativo/inativo) DOS CADASTROS -- so' o servidor muda.
    //
    // Inativar/reativar cliente, fornecedor, produto, materia-prima etc. exige
    // conferir OUTROS documentos (titulo em aberto, receita, saldo...), coisa
    // que as rules nao enxergam. Entao a tela nao pode gravar `ativo` direto:
    // o unico caminho e' POST /api/cadastros/situacao, que roda com o Admin
    // SDK (ignora estas regras) depois de conferir as pendencias. Sem isto,
    // qualquer um com o DevTools aberto pularia as travas da tela.
    // (server/services/cadastroIntegridade.js)
    //
    // Registro INATIVO tambem nao se edita: so' movimento de saldo (venda
    // cancelada devolvendo estoque, credito no banco) passa. Pra alterar
    // dados, reative antes.
    // ---------------------------------------------------------------------
    function cadastroComSituacao(collectionName) {
      return collectionName in [
        'clientes', 'fornecedores', 'motoristas', 'estoque', 'materias_primas', 'categorias', 'marcas',
        'servicos', 'veiculos', 'unidades_medida', 'bancos', 'bandeiras_cartao'
      ];
    }

    function alteraSituacao() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['ativo', 'statusAtivo']);
    }

    function cadastroInativo(collectionName) {
      return resource.data.get('ativo', true) == false ||
        (collectionName == 'estoque' && resource.data.get('statusAtivo', true) == false);
    }

    function soMovimentaSaldo(collectionName) {
      return (
        collectionName in ['estoque', 'materias_primas'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['quantidade', 'quantidadeReservada', 'updatedAt'].concat(documentAuditFields()))
      ) || (
        collectionName == 'bancos' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['saldoCentavos', 'updatedAt'].concat(documentAuditFields()))
      );
    }

    function situacaoRespeitada(collectionName) {
      return !cadastroComSituacao(collectionName) || isSuperAdmin() ||
        (!alteraSituacao() && (!cadastroInativo(collectionName) || soMovimentaSaldo(collectionName)));
    }

    function canDeleteTenantDocument() {
      return isSuperAdmin() ||
        (hasProfile() && perfilAtivo() && resource.data.tenantId == currentTenantId());
    }

    match /usuarios/{userId} {
      // O proprio perfil continua legivel mesmo inativo: e' por ele que o
      // AuthContext descobre o 'Inativo' e desloga.
      allow get: if isSuperAdmin() ||
        (signedIn() && request.auth.uid == userId) ||
        (hasProfile() && perfilAtivo() && resource.data.tenantId == currentTenantId());
      allow list: if isSuperAdmin() ||
        (hasProfile() && perfilAtivo() && resource.data.tenantId == currentTenantId());

      allow create: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          request.resource.data.tenantId == currentTenantId() &&
          request.resource.data.role == 'Funcionario' &&
          !request.resource.data.keys().hasAny(platformManagedFields())
        );

      allow update: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          resource.data.tenantId == currentTenantId() &&
          request.resource.data.tenantId == resource.data.tenantId &&
          request.resource.data.role == resource.data.role &&
          resource.data.role == 'Funcionario' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(tenantUserEditableFields())
        ) ||
        (
          // Gerente so' mexe em 'permissoes' (os modulos liberados) de um
          // Funcionario comum -- nunca no proprio nivel/role, no nivel de
          // OUTRO gerente, no Admin/Master/Dono, nem em si mesmo. Nivel de
          // acesso, acesso mobile, criar/inativar e senha continuam so'
          // isTenantAdmin -- ver tenantUserEditableFields() acima.
          isGerenteDeEquipe() &&
          resource.data.tenantId == currentTenantId() &&
          resource.data.role == 'Funcionario' &&
          !(resource.data.nivelAcesso in ['gerente', 'administracao']) &&
          userId != request.auth.uid &&
          request.resource.data.tenantId == resource.data.tenantId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.nivelAcesso == resource.data.nivelAcesso &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissoes'].concat(documentAuditFields()))
        ) ||
        (
          signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.tenantId == resource.data.tenantId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['activeSessionId', 'activeSession', 'lastSessionEndedAt', 'nome'].concat(documentAuditFields()))
        );

      // So SuperAdmin apaga usuario -- nenhuma tela do app apaga mais
      // conta de funcionario, so inativa (status: 'Inativo', ver
      // UsuariosList.tsx). Antes o Tenant Admin tambem podia; fechado pra
      // nao sobrar um caminho de exclusao fisica sem UI nenhuma usando.
      allow delete: if isSuperAdmin();
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          request.resource.data.tenantId == currentTenantId()
        );
      // Sobrescrever so' o indice da PROPRIA empresa (2026-09-29). Antes o
      // update so' olhava o dado novo: o Admin de uma empresa regravava o
      // login de um funcionario de OUTRA empresa apontando pra outro e-mail,
      // e esse funcionario nao entrava mais no sistema.
      allow update: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          resource.data.tenantId == currentTenantId() &&
          request.resource.data.tenantId == currentTenantId()
        );
      // Mesmo motivo do /usuarios acima -- so SuperAdmin (usado no wipe de
      // tenant do SuperAdmin.tsx).
      allow delete: if isSuperAdmin();
    }

    // Indice publico de login do vendedor de balcao no aplicativo mobile:
    // doc id = "{cnpj}-{codigoVendedor}" -> {tenantId, vendedorId}. So o
    // backend (Admin SDK, ignora estas regras) le -- o app mobile chama o
    // endpoint /api/vendedor/mobile-login, nunca le esta colecao direto.
    // Escrita e' do mesmo jeito que /usernames: o Admin/Master da propria
    // empresa mantem o indice ao ligar/desligar "Usa o aplicativo mobile"
    // em VendedoresList.tsx.
    match /vendedores_mobile_login/{chave} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          request.resource.data.tenantId == currentTenantId()
        );
      // Mesmo motivo do /usernames: so' regrava o indice da propria empresa.
      allow update: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          resource.data.tenantId == currentTenantId() &&
          request.resource.data.tenantId == currentTenantId()
        );
      allow delete: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          resource.data.tenantId == currentTenantId()
        );
    }

    // Quem grava Configuracoes: dono/Admin, ou quem recebeu a permissao
    // 'administrativo.config' -- a MESMA que abre a tela (routeAccess.ts).
    // Ate 2026-09-30 a tela abria pro gerente com a permissao, mas o save era
    // recusado aqui. A chave da Spedy e a senha do e-mail continuam so' em
    // configuracoes_privadas (dono/Admin), e os campos da plataforma seguem
    // travados por platformManagedFields.
    function canEditTenantConfig() {
      return isTenantAdmin() || hasPermission('administrativo.config');
    }

    match /configuracoes/{tenantId} {
      allow read: if canAccessTenant(tenantId);
      allow create: if isSuperAdmin() ||
        (
          canEditTenantConfig() &&
          currentTenantId() == tenantId &&
          request.resource.data.tenantId == tenantId &&
          !request.resource.data.keys().hasAny(platformManagedFields())
        );
      allow update: if isSuperAdmin() ||
        (
          canEditTenantConfig() &&
          currentTenantId() == tenantId &&
          request.resource.data.tenantId == tenantId &&
          doesNotChangePlatformManagedFields()
        );
      allow delete: if isSuperAdmin();
    }

    // Configuracao de plataforma, nao de tenant -- hoje so guarda a chave
    // mestra da conta Spedy (usada pra cadastrar empresa+certificado de
    // cada cliente novo). So o SuperAdmin/NexarAdmin le e escreve; o
    // backend usa Admin SDK e ignora essa regra, mas a tela de
    // administracao (SuperAdmin.tsx) escreve direto pelo client SDK.
    match /plataforma/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /configuracoes_privadas/{tenantId} {
      allow read: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          currentTenantId() == tenantId
        );
      allow create, update: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          currentTenantId() == tenantId &&
          request.resource.data.tenantId == tenantId
        );
      allow delete: if isSuperAdmin();
    }

    // Quem pode consumir uma sequencia (numero de pedido, OS, orcamento ou
    // ordem de producao). 'operacoes.producao' ENTROU em 2026-08-30: a
    // ordem de producao numera pelo mesmo contador desde sempre, mas nao
    // constava aqui -- quem so tinha essa permissao, sem ser Admin, batia
    // em "Missing or insufficient permissions" ao criar a ordem.
    function canConsumeTenantSequence() {
      return canManageTenantData() ||
        hasAnyPermission([
          'mecanica.os', 'vendas.pedidos', 'vendas.orcamentos', 'operacoes.producao', 'estoque.nota_avulsa',
          // Quem cria pre-venda consome a sequencia do pedido (o pedido em si ja'
          // aceitava essas permissoes -- faltava aqui).
          'vendas.pre_venda_criar', 'vendas.pre_venda_editar', 'vendas.pre_venda_finalizar', 'vendas.pre_venda_cancelar',
          // Emitir boleto e gerar remessa consomem as sequencias do nosso numero
          // e da remessa (boleto_nosso_numero_*, boleto_remessa_*). Estava, por
          // engano, em canAdjustStockQuantity (2026-09-29).
          'financeiro.boletos',
          // Numero da rota do romaneio (Rota 01, 02...), 2026-10-01.
          'operacoes.romaneios'
        ]);
    }

    match /contadores/{tenantId} {
      // Documento legado (todas as sequencias em campos do mesmo
      // documento). Continua LEGIVEL porque a transacao ainda le ele para
      // a migracao acontecer sozinha -- ver src/utils/firestoreAtomic.ts.
      //
      // A ESCRITA continua liberada de proposito, mesmo o codigo novo nao
      // usando mais: rules valem na hora em que sao publicadas, mas quem
      // esta com o sistema aberto segue rodando o JavaScript antigo ate
      // recarregar a pagina. Fechar a escrita aqui faria a venda desses
      // usuarios falhar com "Missing or insufficient permissions" ate o
      // F5 deles. Pode fechar (trocar por isSuperAdmin) depois que todo
      // mundo tiver recarregado.
      allow read: if canAccessTenant(tenantId);
      // FECHADO em 2026-09-29, como o comentario acima previa: o codigo novo
      // nunca mais escreve aqui desde 2026-08-30 e a tela recarrega todo dia
      // (VerificadorDataDoSistema). Aberto, deixava qualquer vendedor subir o
      // campo legado -- que a transacao usa como piso -- e pular a numeracao.
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Uma sequencia por documento, para emitir OS nao disputar o mesmo
      // documento de quem esta fechando venda. Ver firestoreAtomic.ts.
      match /sequencias/{sequenceKey} {
        allow read: if canAccessTenant(tenantId);
        allow create: if canAccessTenant(tenantId) &&
          request.resource.data.tenantId == tenantId &&
          canConsumeTenantSequence();
        // Numeracao so' anda pra FRENTE (2026-09-29): a transacao sempre grava
        // max(atual, legado, piso) + 1. Voltar o contador pelo DevTools repetiria
        // numero de pedido, OS e -- pior -- NOSSO NUMERO de boleto (dois
        // boletos com o mesmo numero no banco = pagamento baixado no titulo errado).
        allow update: if canAccessTenant(tenantId) &&
          request.resource.data.tenantId == tenantId &&
          canConsumeTenantSequence() &&
          (
            !(resource.data.valor is number) ||
            (request.resource.data.valor is number && request.resource.data.valor > resource.data.valor)
          );
        allow delete: if isSuperAdmin();
      }
    }

    match /system_alerts/{alertId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /onboarding_pendentes/{documentId} {
      allow read, write: if false;
    }

    match /cnpjs_cadastrados/{documentId} {
      allow read, write: if false;
    }

    // PIN do vendedor (identificacao na hora da venda). NEGADO PARA TODO
    // MUNDO de proposito: so o Admin SDK (que ignora estas rules, ou seja, so
    // o backend) alcanca. O PIN tem 4 digitos -- 10.000 combinacoes -- entao
    // qualquer leitura do hash pelo navegador o tornaria inutil em
    // milissegundos. O codigo do vendedor, que NAO e' segredo, fica em
    // usuarios/{uid}.codigoVendedor. Ver server/services/vendedorPin.js.
    //
    // A regra generica /{collectionName}/{documentId} mais abaixo usa lista
    // de permissao, entao esta colecao ja cairia no `if false` final -- isto
    // aqui e' explicito pra ninguem liberar por engano ao mexer naquela lista.
    match /usuarios_pin/{documentId} {
      allow read, write: if false;
    }

    match /empresas/{tenantId}/logs/{logId} {
      // Log sai sempre no nome de quem esta logado (2026-09-29): antes qualquer
      // usuario gravava log com o usuarioId de um colega e a auditoria passava
      // a acusar outra pessoa. O servidor grava pelos proprios meios (Admin SDK).
      allow create: if canAccessTenant(tenantId) &&
        (isSuperAdmin() || request.resource.data.usuarioId == request.auth.uid);
      allow read: if isSuperAdmin() ||
        (
          canAccessTenant(tenantId) &&
          (isTenantAdmin() || hasPermission('administrativo.logs'))
        );
      // Apagar so' o que a limpeza automatica apaga (runLogsCleanup: log comum
      // com mais de 6 meses). Antes, quem via os logs apagava QUALQUER um --
      // inclusive o registro critico de uma exclusao, logo depois de fazer.
      allow delete: if isSuperAdmin() ||
        (
          canAccessTenant(tenantId) &&
          (isTenantAdmin() || hasPermission('administrativo.logs')) &&
          resource.data.critical == false &&
          resource.data.dataHora < request.time - duration.value(170, 'd')
        );
      allow update: if false;
    }

    // Kardex do Ajuste Manual de Estoque. Registro imutavel (sem update/delete)
    // de proposito -- corrige-se um ajuste errado com um novo ajuste, igual
    // trilha de auditoria financeira, nunca reescrevendo o que ja aconteceu.
    match /ajustes_estoque/{documentId} {
      allow read: if isSuperAdmin() ||
        (
          canAccessTenant(resource.data.tenantId) &&
          (canManageTenantData() || hasAnyPermission(['estoque.ajusteManual', 'estoque.relatorioAjustes']))
        );
      allow create: if isSuperAdmin() ||
        (
          hasProfile() &&
          perfilAtivo() &&
          request.resource.data.tenantId == currentTenantId() &&
          (canManageTenantData() || hasPermission('estoque.ajusteManual'))
        );
      allow update, delete: if false;
    }

    match /{collectionName}/{documentId} {
      allow read: if collectionName in [
        'clientes',
        'veiculos',
        'produtos',
        'estoque',
        'materias_primas',
        'categorias',
        'marcas',
        'servicos',
        'transacoes',
        'ordens_de_servico',
        'lembretes',
        'agendamentos',
        'pedidos_venda',
        'orcamentos',
        'devolucoes_venda',
        'unidades_medida',
        'bandeiras_cartao',
        'bancos',
        'lancamentos_bancarios',
        'notas_fiscais',
        'notas_fiscais_entrada',
        'creditos_cliente',
        'fornecedores',
        'motoristas',
        'frota',
        'insumos',
        'rotas',
        'romaneios',
        'romaneio_pedidos',
        'promocoes',
        'cotacoes_compra',
        'pedidos_compra',
        'recebimentos_compra',
        'historico_custos',
        'integracoes_canais',
        'integracoes_produtos',
        'integracoes_fila',
        'pedidos_externos',
        'integracoes_logs',
        'ordens_producao',
        'produtos_composicao',
        'estoque_lotes',
        'expedicoes',
        'entregas',
        'caixas_pdv',
        'notas_avulsas',
        // Trocas de mercadoria: SO' LEITURA aqui. Criar, aprovar, entregar e baixar o estoque
        // acontece no servidor (Admin SDK, server/routes/trocas.routes.js) -- de proposito ela NAO
        // esta nas listas de create/update/delete abaixo, entao o app nunca escreve nela.
        'trocas',
        // Condicional (2026-10-05): SO' LEITURA, como trocas. Saida, devolucao, fechamento
        // (que gera a pre-venda) e cancelamento -- e a reserva de estoque -- sao gravados
        // pelo servidor (server/routes/condicionais.routes.js).
        'condicionais'
      ] && canReadTenantDocument();

      allow create: if collectionName in [
        'clientes',
        'veiculos',
        'produtos',
        'estoque',
        'materias_primas',
        'categorias',
        'marcas',
        'servicos',
        'transacoes',
        'ordens_de_servico',
        'lembretes',
        'agendamentos',
        'pedidos_venda',
        'orcamentos',
        'devolucoes_venda',
        'unidades_medida',
        'bandeiras_cartao',
        'bancos',
        'lancamentos_bancarios',
        'notas_fiscais',
        'notas_fiscais_entrada',
        'creditos_cliente',
        'fornecedores',
        'motoristas',
        'frota',
        'insumos',
        'rotas',
        'romaneios',
        'romaneio_pedidos',
        'promocoes',
        'cotacoes_compra',
        'pedidos_compra',
        'recebimentos_compra',
        'historico_custos',
        'integracoes_canais',
        'integracoes_produtos',
        'integracoes_fila',
        'pedidos_externos',
        'integracoes_logs',
        'ordens_producao',
        'produtos_composicao',
        'estoque_lotes',
        'expedicoes',
        'entregas',
        'caixas_pdv',
        'notas_avulsas'
      ] && canCreateTenantDocument() && canWriteTenantCollection(collectionName);

      allow update: if collectionName in [
        'clientes',
        'veiculos',
        'produtos',
        'estoque',
        'materias_primas',
        'categorias',
        'marcas',
        'servicos',
        'transacoes',
        'ordens_de_servico',
        'lembretes',
        'agendamentos',
        'pedidos_venda',
        'orcamentos',
        'devolucoes_venda',
        'unidades_medida',
        'bandeiras_cartao',
        'bancos',
        'notas_fiscais',
        'notas_fiscais_entrada',
        'creditos_cliente',
        'fornecedores',
        'motoristas',
        'frota',
        'insumos',
        'rotas',
        'romaneios',
        'romaneio_pedidos',
        'promocoes',
        'cotacoes_compra',
        'pedidos_compra',
        'recebimentos_compra',
        'historico_custos',
        'integracoes_canais',
        'integracoes_produtos',
        'integracoes_fila',
        'pedidos_externos',
        'integracoes_logs',
        'ordens_producao',
        'produtos_composicao',
        'estoque_lotes',
        'expedicoes',
        'entregas',
        'caixas_pdv',
        'notas_avulsas'
      ] && canUpdateTenantDocument() && situacaoRespeitada(collectionName) && (
        // Os movimentos de SALDO vem PRIMEIRO de proposito (2026-09-29): sao
        // as escritas mais comuns (toda venda mexe em estoque e banco) e as
        // mais baratas de conferir. O Firestore para de avaliar a regra depois
        // de 1000 expressoes e NEGA -- com canWriteTenantCollection na frente,
        // o estorno de uma venda em banco inativo passava desse limite
        // (medido no simulador de regras) e a venda nao cancelava.
        (collectionName == 'estoque' && canAdjustStockQuantity()) ||
        (collectionName == 'bancos' && canMoveBankBalance()) ||
        (collectionName == 'estoque_lotes' && canAdjustLoteQuantity()) ||
        (collectionName == 'materias_primas' && canAdjustMateriaPrimaQuantity()) ||
        (collectionName == 'pedidos_venda' && canCloseConferenciaOnPedido()) ||
        canWriteTenantCollection(collectionName)
      );

      allow delete: if collectionName in [
        'clientes',
        'veiculos',
        'produtos',
        'estoque',
        'materias_primas',
        'categorias',
        'marcas',
        'servicos',
        'transacoes',
        'ordens_de_servico',
        'lembretes',
        'agendamentos',
        'pedidos_venda',
        'orcamentos',
        'devolucoes_venda',
        'unidades_medida',
        'bandeiras_cartao',
        'bancos',
        'notas_fiscais',
        'notas_fiscais_entrada',
        'creditos_cliente',
        'fornecedores',
        'motoristas',
        'frota',
        'insumos',
        'rotas',
        'romaneios',
        'romaneio_pedidos',
        'promocoes',
        'cotacoes_compra',
        'pedidos_compra',
        'recebimentos_compra',
        'historico_custos',
        'integracoes_canais',
        'integracoes_produtos',
        'integracoes_fila',
        'pedidos_externos',
        'integracoes_logs',
        'ordens_producao',
        'produtos_composicao',
        'estoque_lotes',
        'expedicoes',
        'entregas',
        'caixas_pdv'
      ] && canDeleteTenantDocument() && canDeleteTenantCollection(collectionName);
    }

    match /backups_historico/{documentId} {
      allow read, write: if isSuperAdmin();
    }

    match /backups_configuracoes/{tenantId} {
      allow read, write: if isSuperAdmin();
    }

    match /restauracoes_historico/{documentId} {
      allow read, write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

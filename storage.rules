rules_version = '2';

// Regras do Firebase Storage (2026-10-06). Ate' aqui o front nao usava o
// Storage: o logo da empresa ia em base64 dentro de configuracoes/{tenantId},
// documento que quase toda tela baixa -- cada abertura de tela puxava a
// imagem de novo. Agora o logo e' um arquivo aqui e o documento guarda so' o
// link. Os backups do servidor (Admin SDK) nao passam por estas regras.
service firebase.storage {
  match /b/{bucket}/o {
    // Logo da empresa: leitura publica (sai nas impressoes e no PDF, sem
    // login), gravacao so' por usuario da PROPRIA empresa, imagem ate' 2 MB.
    // Bloco B de seguranca (25/11/2026): trocar o logo so' quem pode mexer nas
    // Configuracoes (dono, administrador ou "Admin: Configuracoes"), com perfil ativo.
    match /empresas/{tenantId}/logo/{arquivo} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && usuarioDaEmpresa(tenantId)
        && podeMexerNasConfiguracoes();
      allow delete: if false;
    }

    // Fotos e assinatura do atendimento da OS (app do tecnico, 2026-10-08):
    // leitura e gravacao so' por usuario da PROPRIA empresa (matriz ou
    // filial ativa), imagem ate' 5 MB. Apagar so' a propria empresa tambem
    // (o tecnico tira a foto errada). O caminho e' montado em osCampoDomain.ts.
    match /empresas/{tenantId}/os/{osId}/{arquivo} {
      allow read: if request.auth != null && usuarioDaEmpresa(tenantId);
      allow create, update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && usuarioDaEmpresa(tenantId);
      allow delete: if request.auth != null && usuarioDaEmpresa(tenantId);
    }

    // Foto do canhoto da entrega (app do motorista, 2026-10-08): mesmas
    // regras das fotos da OS. Caminho montado em entregaCampoDomain.ts.
    match /empresas/{tenantId}/romaneios/{romaneioId}/{arquivo} {
      allow read: if request.auth != null && usuarioDaEmpresa(tenantId);
      allow create, update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && usuarioDaEmpresa(tenantId);
      allow delete: if request.auth != null && usuarioDaEmpresa(tenantId);
    }

    // PDF do orcamento enviado ao cliente pelo WhatsApp (2026-11-23): a
    // mensagem leva o link com token do arquivo, e o cliente abre sem login
    // (link com token nao passa por estas regras). Gravacao so' pela PROPRIA
    // empresa, so' PDF, ate' 10 MB. Caminho montado em enviarOrcamentoPdf.tsx.
    match /empresas/{tenantId}/orcamentos/{orcamentoId}/{arquivo} {
      allow read: if request.auth != null && usuarioDaEmpresa(tenantId);
      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && usuarioDaEmpresa(tenantId);
      allow delete: if request.auth != null && usuarioDaEmpresa(tenantId);
    }

    // Boleto da mensalidade (24/11/2026): o PDF do PicPay que o admin da
    // plataforma anexa no SuperAdmin. So' ele grava e le por aqui; a empresa
    // abre pelo link com token (copiado no perfil pelo servidor), que nao passa
    // por estas regras. So' PDF, ate' 10 MB. Caminho em SuperAdminMensalidades.tsx.
    match /cobranca/{tenantId}/{arquivo} {
      allow read, delete: if request.auth != null && adminDaPlataforma();
      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && adminDaPlataforma();
    }

    function adminDaPlataforma() {
      return request.auth.token.get('role', '') in ['NexarAdmin', 'SuperAdmin']
        || request.auth.token.get('nexarAdmin', false) == true
        || request.auth.token.get('superAdmin', false) == true
        || firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('role', '') in ['NexarAdmin', 'SuperAdmin'];
    }

    // Bloco B de seguranca (25/11/2026): o perfil tem de estar ATIVO, sem bloqueio
    // de mensalidade, e vendedor de balcao so' com o login do codigo -- a mesma
    // regra de perfilAtivo() nas firestore.rules. Antes o Storage so' conferia a
    // empresa: inativado e empresa bloqueada seguiam lendo e gravando arquivos.
    // Uma leitura so' (o mesmo documento do perfil).
    function usuarioDaEmpresa(tenantId) {
      let perfil = firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
      // uid igual ao id da empresa so' vale com a ficha confirmando (auditoria de 24/11/2026):
      // um login emitido para o id de uma filial alheia nao abre os arquivos dela.
      return ((request.auth.uid == tenantId && perfil.tenantId == tenantId)
          || perfil.get('filialAtiva', perfil.tenantId) == tenantId)
        && (perfil.get('status', 'Ativo') != 'Inativo' || perfil.tenantId == request.auth.uid)
        && (!('cobrancaBloqueioEm' in perfil) || request.time < perfil.cobrancaBloqueioEm)
        && (perfil.get('tipoRegistro', '') != 'vendedor' || request.auth.token.get('isVendedorBalcao', false) == true);
    }

    // Revisao de 25/11: a equipe da plataforma (suporte) continua trocando o logo.
    function podeMexerNasConfiguracoes() {
      let perfil = firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
      return perfil.get('role', '') in ['Master', 'Admin', 'NexarAdmin', 'SuperAdmin']
        || perfil.get('permissoes', []).hasAny(['administrativo.config'])
        || adminDaPlataforma();
    }

    match /{resto=**} {
      allow read, write: if false;
    }
  }
}

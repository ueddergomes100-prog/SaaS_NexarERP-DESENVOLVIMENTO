rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    function currentTenantId() {
      return hasProfile() ? currentProfile().tenantId : request.auth.uid;
    }

    function currentRole() {
      return hasProfile() ? currentProfile().role : null;
    }

    function tokenIsSuperAdmin() {
      return signedIn() && (
        request.auth.token.role == 'SuperAdmin' ||
        request.auth.token.superAdmin == true
      );
    }

    function isSuperAdmin() {
      return tokenIsSuperAdmin() || (hasProfile() && currentRole() == 'SuperAdmin');
    }

    function isTenantAdmin() {
      return hasProfile() && currentRole() == 'Admin';
    }

    function hasPermission(permission) {
      return hasProfile() &&
        currentProfile().permissoes is list &&
        currentProfile().permissoes.hasAny([permission]);
    }

    function canAccessTenant(tenantId) {
      return isSuperAdmin() || (signedIn() && currentTenantId() == tenantId);
    }

    function canReadTenantDocument() {
      return isSuperAdmin() || (signedIn() && resource.data.tenantId == currentTenantId());
    }

    function canCreateTenantDocument() {
      return isSuperAdmin() ||
        (hasProfile() && request.resource.data.tenantId == currentTenantId());
    }

    function canUpdateTenantDocument() {
      return isSuperAdmin() ||
        (
          hasProfile() &&
          resource.data.tenantId == currentTenantId() &&
          request.resource.data.tenantId == resource.data.tenantId
        );
    }

    function canDeleteTenantDocument() {
      return isSuperAdmin() ||
        (hasProfile() && resource.data.tenantId == currentTenantId());
    }

    match /usuarios/{userId} {
      allow get: if isSuperAdmin() ||
        (signedIn() && request.auth.uid == userId) ||
        (hasProfile() && resource.data.tenantId == currentTenantId());
      allow list: if isSuperAdmin() ||
        (hasProfile() && resource.data.tenantId == currentTenantId());

      allow create: if isSuperAdmin() ||
        (
          signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.tenantId == userId &&
          request.resource.data.role == 'Admin'
        ) ||
        (
          isTenantAdmin() &&
          request.resource.data.tenantId == currentTenantId() &&
          request.resource.data.role == 'Funcionario'
        );

      allow update: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          resource.data.tenantId == currentTenantId() &&
          request.resource.data.tenantId == resource.data.tenantId &&
          resource.data.role != 'SuperAdmin' &&
          request.resource.data.role != 'SuperAdmin'
        ) ||
        (
          signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.tenantId == resource.data.tenantId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['activeSessionId', 'nome'])
        );

      allow delete: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          resource.data.tenantId == currentTenantId() &&
          resource.data.role == 'Funcionario'
        );
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          request.resource.data.tenantId == currentTenantId()
        );
      allow delete: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          resource.data.tenantId == currentTenantId()
        );
    }

    match /configuracoes/{tenantId} {
      allow read: if canAccessTenant(tenantId);
      allow create: if isSuperAdmin() ||
        (
          signedIn() &&
          request.auth.uid == tenantId &&
          request.resource.data.tenantId == tenantId
        ) ||
        (
          isTenantAdmin() &&
          currentTenantId() == tenantId &&
          request.resource.data.tenantId == tenantId
        );
      allow update: if isSuperAdmin() ||
        (
          isTenantAdmin() &&
          currentTenantId() == tenantId &&
          request.resource.data.tenantId == tenantId
        );
      allow delete: if isSuperAdmin();
    }

    match /system_alerts/{alertId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /empresas/{tenantId}/logs/{logId} {
      allow create: if canAccessTenant(tenantId);
      allow read, delete: if isSuperAdmin() ||
        (
          canAccessTenant(tenantId) &&
          (isTenantAdmin() || hasPermission('administrativo.logs'))
        );
      allow update: if false;
    }

    match /{collectionName}/{documentId} {
      allow read: if collectionName in [
        'clientes',
        'veiculos',
        'produtos',
        'estoque',
        'categorias',
        'servicos',
        'transacoes',
        'ordens_de_servico',
        'lembretes',
        'agendamentos',
        'pedidos_venda',
        'orcamentos',
        'devolucoes_venda',
        'unidades_medida',
        'notas_fiscais',
        'creditos_cliente',
        'fornecedores',
        'cotacoes_compra',
        'pedidos_compra',
        'recebimentos_compra',
        'historico_custos',
        'integracoes_canais',
        'integracoes_produtos',
        'integracoes_fila',
        'pedidos_externos',
        'integracoes_logs',
        'ordens_producao',
        'produtos_composicao',
        'estoque_lotes',
        'expedicoes',
        'entregas'
      ] && canReadTenantDocument();

      allow create: if collectionName in [
        'clientes',
        'veiculos',
        'produtos',
        'estoque',
        'categorias',
        'servicos',
        'transacoes',
        'ordens_de_servico',
        'lembretes',
        'agendamentos',
        'pedidos_venda',
        'orcamentos',
        'devolucoes_venda',
        'unidades_medida',
        'notas_fiscais',
        'creditos_cliente',
        'fornecedores',
        'cotacoes_compra',
        'pedidos_compra',
        'recebimentos_compra',
        'historico_custos',
        'integracoes_canais',
        'integracoes_produtos',
        'integracoes_fila',
        'pedidos_externos',
        'integracoes_logs',
        'ordens_producao',
        'produtos_composicao',
        'estoque_lotes',
        'expedicoes',
        'entregas'
      ] && canCreateTenantDocument();

      allow update: if collectionName in [
        'clientes',
        'veiculos',
        'produtos',
        'estoque',
        'categorias',
        'servicos',
        'transacoes',
        'ordens_de_servico',
        'lembretes',
        'agendamentos',
        'pedidos_venda',
        'orcamentos',
        'devolucoes_venda',
        'unidades_medida',
        'notas_fiscais',
        'creditos_cliente',
        'fornecedores',
        'cotacoes_compra',
        'pedidos_compra',
        'recebimentos_compra',
        'historico_custos',
        'integracoes_canais',
        'integracoes_produtos',
        'integracoes_fila',
        'pedidos_externos',
        'integracoes_logs',
        'ordens_producao',
        'produtos_composicao',
        'estoque_lotes',
        'expedicoes',
        'entregas'
      ] && canUpdateTenantDocument();

      allow delete: if collectionName in [
        'clientes',
        'veiculos',
        'produtos',
        'estoque',
        'categorias',
        'servicos',
        'transacoes',
        'ordens_de_servico',
        'lembretes',
        'agendamentos',
        'pedidos_venda',
        'orcamentos',
        'devolucoes_venda',
        'unidades_medida',
        'notas_fiscais',
        'creditos_cliente',
        'fornecedores',
        'cotacoes_compra',
        'pedidos_compra',
        'recebimentos_compra',
        'historico_custos',
        'integracoes_canais',
        'integracoes_produtos',
        'integracoes_fila',
        'pedidos_externos',
        'integracoes_logs',
        'ordens_producao',
        'produtos_composicao',
        'estoque_lotes',
        'expedicoes',
        'entregas'
      ] && canDeleteTenantDocument();
    }

    match /backups_historico/{documentId} {
      allow read, write: if isSuperAdmin();
    }

    match /backups_configuracoes/{tenantId} {
      allow read, write: if isSuperAdmin();
    }

    match /restauracoes_historico/{documentId} {
      allow read, write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# Backend base
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5174
# Inclua aqui o dominio do app e o futuro subdominio administrativo em producao.
# Ex: https://app.seudominio.com,https://admin.seudominio.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Firebase Admin SDK - use somente o projeto de testes no ambiente local.
FIREBASE_PROJECT_ID=sistema-nexus-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Onboarding seguro
# Obrigatorio em producao. Use um valor longo e aleatorio.
ONBOARDING_CODE_SECRET=

# Em desenvolvimento, permite receber os codigos no console/resposta da API.
# Nunca habilitar em producao.
ONBOARDING_DEV_CODES=true

# Validacao de CNPJ
# brasilapi funciona para desenvolvimento. Em producao, prefira serpro quando contratado/configurado.
CNPJ_PROVIDER=brasilapi
# CNPJ_PROVIDER=serpro
# SERPRO_CNPJ_BASE_URL=
# SERPRO_CNPJ_BEARER_TOKEN=

# Consulta de CPF (nome/genero/data de nascimento) via apicpf.com.
# Sem esta chave, a "lupa"/autopreenchimento de CPF fica limitada ao
# digito verificador (sempre disponivel, calculado no frontend).
APICPF_API_KEY=

# Envio de e-mail de verificacao
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM=Hennder ERP <cadastro@seudominio.com>

# Envio de SMS/WhatsApp via provedor transacional
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_PHONE=

# Webhook da Spedy (invoice.status_changed) -- a Spedy nao assina o
# webhook, entao esse token embutido na URL de registro e a unica
# protecao. Gere um valor longo e aleatorio; registre o webhook na Spedy
# apontando pra https://SEU_BACKEND/api/spedy-webhook/<esse-valor>.
SPEDY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Backups (services/backup.js e services/cloudStorage.js)
# ---------------------------------------------------------------------------
# Bucket usado pra guardar os backups. Sem valor, cai em
# `${FIREBASE_PROJECT_ID}.firebasestorage.app`.
FIREBASE_STORAGE_BUCKET=

# OBRIGATORIO em producao: com NODE_ENV=production e esta variavel vazia, o
# servico de backup LANCA ERRO ("BACKUP_ENCRYPTION_KEY e obrigatorio em
# producao"). Em desenvolvimento ele apenas avisa e usa uma chave local.
# Use um valor longo e aleatorio -- e guarde-o: sem ele nao ha como
# restaurar um backup ja criado.
BACKUP_ENCRYPTION_KEY=

# Pasta temporaria onde o backup e' montado antes de subir pro bucket.
# Padrao: ./storage/backups (relativo a pasta do backend). Em hospedagem
# compartilhada, lembrar que isso consome disco e inodes da conta.
BACKUP_LOCAL_TEMP_PATH=./storage/backups

# Retencao por tipo de backup (em quantidade de copias mantidas).
BACKUP_RETENTION_DAILY=
BACKUP_RETENTION_WEEKLY=
BACKUP_RETENTION_MONTHLY=

# --- Credencial do Firebase Admin: escolha UMA das duas formas ---------------
#
# FORMA 1 (RECOMENDADA em hospedagem): o JSON inteiro da conta de servico em
# base64, numa variavel so. Base64 nao tem quebra de linha, aspas nem
# caractere especial -- nenhum painel consegue corromper. Gere assim:
#   node -e "console.log(require('fs').readFileSync('conta-servico.json').toString('base64'))"
# FIREBASE_SERVICE_ACCOUNT_BASE64=
#
# FORMA 2 (legado): as duas variaveis separadas. Funciona, mas a chave privada
# tem ~1700 caracteres e quebras escapadas -- o formato que paineis de
# hospedagem costumam truncar ou guardar com aspas. Use so se ja estiver
# configurado assim. Ver FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY acima.
